  {"action": "shell", "resource": "*", "effect": "allow"},   // 1. broad allows first
  {"action": "external_directory", "resource": "*", "effect": "allow"},
  {"action": "shell", "resource": "ssh *", "effect": "ask"},   // 2. remote access
  {"action": "shell", "resource": "scp *", "effect": "ask"},
  {"action": "shell", "resource": "sftp *", "effect": "ask"},
  {"action": "shell", "resource": "rsync *", "effect": "ask"},
  {"action": "shell", "resource": "sudo *", "effect": "ask"},
  {"action": "shell", "resource": "su *", "effect": "ask"},
  {"action": "shell", "resource": "rm -r *", "effect": "ask"},   // 3. recursive rm in any form (`rm file`, `rm -f file` stay prompt-free)
  {"action": "shell", "resource": "rm -R *", "effect": "ask"},
  {"action": "shell", "resource": "rm -rf *", "effect": "ask"},
  {"action": "shell", "resource": "rm -fr *", "effect": "ask"},
