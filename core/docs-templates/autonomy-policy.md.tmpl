  {"action": "shell", "resource": "sh -*", "effect": "ask"},
  {"action": "shell", "resource": "bash -*", "effect": "ask"},
  {"action": "shell", "resource": "zsh -*", "effect": "ask"},   // 7. pipe-to-shell (pipelines are checked per command, so `sh`/`bash -` alone matter)
