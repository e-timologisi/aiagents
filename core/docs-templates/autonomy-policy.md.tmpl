  {"action": "shell", "resource": "git push * --force*", "effect": "deny"},   // 8. hard denies LAST: force pushes (incl. -f and --force-with-lease) and repository deletion
  {"action": "shell", "resource": "git push -f*", "effect": "deny"},   // 8. hard denies LAST: force pushes (incl. -f and --force-with-lease) and repository deletion
  {"action": "shell", "resource": "git push * -f", "effect": "deny"},   // 8. hard denies LAST: force pushes (incl. -f and --force-with-lease) and repository deletion
